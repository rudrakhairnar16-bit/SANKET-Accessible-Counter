# Optional server-side integration settings. Keep real keys in .env.local only.
# Do not expose these variables with a NEXT_PUBLIC_ prefix.

# Compatible single-frame sign suggestion endpoint. It must accept JSON:
# { "image": "data:image/jpeg;base64,...", "language": "ISL" | "ASL" }
# and return { "label": "...", "confidence": 0.0-1.0, "language"?: "ISL" | "ASL", "note"?: "..." }.
# The app sends a still frame only after the user checks consent and presses Analyze frame.
SANKET_RECOGNITION_ENDPOINT=
SANKET_RECOGNITION_API_KEY=

# Optional dispatch webhook endpoint. It receives a minimal assistance request and should
# return JSON { "requestId"?: "...", "status"?: "accepted", "message"?: "..." }.
# This is request dispatch only; it does NOT create a live video interpreter connection.
SANKET_INTERPRETER_REQUEST_ENDPOINT=
SANKET_INTERPRETER_API_KEY=

# Optional comma-separated browser origins allowed to call protected POST APIs
SANKET_ALLOWED_ORIGINS=http://localhost:3000
